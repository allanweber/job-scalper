# Job Scalper — deployment environment. Copy to `.env` and fill in.
# NEVER commit the real .env. All values here are read by the api/admin/worker/
# scheduler containers (see docs/deployment/running-services.md for the contract).

# --- Database (managed Dokploy PostgreSQL service) ---
# Use the INTERNAL connection details Dokploy shows for your Postgres service.
# The host is that service's internal hostname (reachable over dokploy-network).
SCALPER_DATABASE_URL=postgresql://scalper:CHANGE_ME@REPLACE-postgres-host:5432/scalper

# --- Job queue / admin sessions ---
SCALPER_REDIS_URL=redis://redis:6379/0

# --- Mobile auth (access JWT + Google ID-token verification) ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SCALPER_JWT_SECRET=
# Comma-separated Google OAuth client IDs accepted on mobile ID tokens
# (the Android client id and the server/audience client id).
SCALPER_GOOGLE_AUDIENCES=

# --- Admin allowlist (source of truth for the admin role) ---
SCALPER_ADMIN_EMAILS=you@example.com

# --- BYO LLM key encryption (envelope, version-tagged) ---
# Generate a key: python -c "from scalper.service.crypto import generate_master_key_b64 as g; print(g())"
# Then: SCALPER_ENC_KEYS={"1":"<that base64 key>"}
SCALPER_ENC_KEYS=
SCALPER_ENC_ACTIVE_VERSION=1

# --- Platform LLM key (operator pays for free-tier users) ---
SCALPER_PLATFORM_ANTHROPIC_KEY=
SCALPER_PLATFORM_LLM_PROVIDER=anthropic

# --- Admin web app ---
# A separate Google *web* OAuth client (redirect URI: https://<admin-domain>/auth/callback).
SCALPER_ADMIN_GOOGLE_CLIENT_ID=
SCALPER_ADMIN_GOOGLE_CLIENT_SECRET=
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SCALPER_ADMIN_COOKIE_SECRET=
# Public URL of the admin app (used to build the OAuth redirect URI).
SCALPER_ADMIN_BASE_URL=https://admin.example.com
# Set to 1 ONLY for local http testing (allows a non-Secure session cookie).
SCALPER_ADMIN_COOKIE_INSECURE=

# --- API CORS (mobile is native, so * is fine; tighten if a web client is added) ---
SCALPER_CORS_ORIGINS=*

# --- Logging (structured request logs for the API + admin apps) ---
# Root log level: DEBUG | INFO | WARNING | ERROR. Health probes log at DEBUG,
# so they're silent at the default INFO.
LOG_LEVEL=INFO
# Output format: json (default, one structured line per request) or text
# (human-readable, handy for local dev).
LOG_FORMAT=json

# --- Cloudflare Tunnel (the only ingress; no host ports are published) ---
CLOUDFLARE_TUNNEL_TOKEN=
