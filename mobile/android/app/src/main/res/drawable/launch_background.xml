<?xml version="1.0" encoding="utf-8"?>
<!-- Branded native splash: teal fill with the centered mint glyph. Replaced by
     the Flutter UI once the engine draws its first frame. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/brand_splash" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@mipmap/ic_launcher_foreground" />
    </item>
</layer-list>
